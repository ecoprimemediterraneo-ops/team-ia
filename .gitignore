# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Solo el `data/` de la raíz: ahí caen los JSON de desarrollo, que no viajan.
# Sin la barra de delante también se tragaba `src/data/`, donde viven los datos
# semilla de la gestoría de demostración — que SÍ tienen que viajar, porque en
# producción no existe ninguna otra forma de que lleguen.
/data/
.env*.local
